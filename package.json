{
  "name": "wirebay",
  "version": "0.1.0",
  "description": "Define MCP servers once, keep secrets in one place, and sync them to every AI coding tool (Claude Code, Claude Desktop, Codex, Cursor, VS Code, Gemini CLI).",
  "type": "module",
  "bin": {
    "wirebay": "dist/cli.js"
  },
  "files": [
    "dist",
    "presets",
    "tools",
    "schemas",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "node scripts/clean.ts && tsc -p tsconfig.build.json",
    "lint": "npm run lint:types && npm run lint:eslint && npm run format:check",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "validate": "node scripts/validate.ts",
    "new:tool": "node scripts/new-tool.ts",
    "new:server": "node scripts/new-server.ts",
    "gen:docs": "node scripts/gen-docs.ts",
    "prepublishOnly": "npm run check && npm run build",
    "release": "npm run build && changeset publish",
    "changeset": "changeset",
    "docs:api": "typedoc",
    "lint:types": "tsc -p tsconfig.json --noEmit",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:docs": "typedoc --treatWarningsAsErrors --emit none",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm test && npm run validate && npm run lint:docs",
    "prepare": "simple-git-hooks"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "claude-desktop",
    "codex",
    "cursor",
    "vscode",
    "gemini",
    "ai-tools",
    "cli"
  ],
  "author": "wirebay contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pragnalabs-ai/wirebay.git"
  },
  "homepage": "https://github.com/pragnalabs-ai/wirebay#readme",
  "bugs": {
    "url": "https://github.com/pragnalabs-ai/wirebay/issues"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "ajv": "^8.20.0",
    "diff": "^9.0.0",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run check"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
