# ─────────────────────────────────────────────────────────────
# wirebay central secrets. NEVER commit or share this file.
# Location: ~/.wirebay/secrets.env  (override: WIREBAY_HOME)
# Manage keys individually: wirebay secrets set|unset|list <KEY>
# Each server only receives the keys it declares.
# Quote values containing spaces or '#':  KEY="value # not a comment"
# ─────────────────────────────────────────────────────────────

# ── github ── https://github.com/pragnalabs-ai/wirebay/blob/main/docs/servers/github.md
# Fine-grained PAT: https://github.com/settings/personal-access-tokens
GITHUB_PERSONAL_ACCESS_TOKEN=
# Optional: limit toolsets (repos,issues,pull_requests,actions,code_security,...)
GITHUB_TOOLSETS=repos,issues,pull_requests,actions
# Optional: GitHub Enterprise MCP endpoint (leave empty for github.com)
GITHUB_MCP_URL=
# Optional (docker variant): GitHub Enterprise Server host, e.g. https://github.example.com
GITHUB_HOST=

# ── netlify ── https://github.com/pragnalabs-ai/wirebay/blob/main/docs/servers/netlify.md
# app.netlify.com → User settings → Applications → Personal access tokens
NETLIFY_PERSONAL_ACCESS_TOKEN=

# ── firebase ── https://github.com/pragnalabs-ai/wirebay/blob/main/docs/servers/firebase.md
# Option A (automation): path to a service-account JSON kept in ~/.wirebay/credentials/
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: leave the line above empty and run `npx firebase-tools login` once
# Optional: project directory containing firebase.json
FIREBASE_PROJECT_DIR=

# ── aws-api / aws-docs ── https://github.com/pragnalabs-ai/wirebay/blob/main/docs/servers/aws.md
# Preferred: a named profile from ~/.aws (aws configure --profile mcp / aws configure sso)
AWS_PROFILE=mcp
AWS_REGION=us-east-1
# Safety: only allow read/list/describe operations (set to false to allow changes)
READ_OPERATIONS_ONLY=true
# Fallback only if you cannot use a profile (static keys; rotate regularly)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
