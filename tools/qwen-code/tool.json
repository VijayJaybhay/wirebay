{
  "$schema": "../../schemas/tool.schema.json",
  "version": 1,
  "id": "qwen-code",
  "name": "Qwen Code",
  "aliases": [
    "qwen"
  ],
  "homepage": "https://github.com/QwenLM/qwen-code",
  "docs": {
    "mcp": "https://qwenlm.github.io/qwen-code-docs/en/users/features/mcp/"
  },
  "detect": {
    "commands": [
      "qwen"
    ],
    "paths": [
      "~/.qwen"
    ]
  },
  "configs": {
    "user": {
      "path": "~/.qwen/settings.json",
      "createIfMissing": true
    },
    "project": {
      "path": "{cwd}/.qwen/settings.json",
      "createIfMissing": true
    }
  },
  "format": "jsonc",
  "rootKey": "mcpServers",
  "entry": {
    "stdio": {
      "command": "{command}",
      "args": "{args}",
      "env": "{env}"
    }
  },
  "supports": {
    "stdio": true,
    "http": true,
    "envExpansion": true,
    "cmdShims": false
  },
  "restartRequired": true,
  "status": "stable",
  "mergeStrategy": "edit",
  "lastVerified": "2026-09-25",
  "maintainers": []
}
