{
  "$schema": "../../schemas/tool.schema.json",
  "version": 1,
  "id": "rovo-dev",
  "name": "Atlassian Rovo Dev CLI",
  "aliases": ["rovodev", "rovo"],
  "homepage": "https://www.atlassian.com/software/rovo-dev",
  "docs": {
    "mcp": "https://support.atlassian.com/rovo/docs/connect-to-an-mcp-server-in-rovo-dev-cli/"
  },
  "detect": {
    "commands": ["acli"],
    "paths": ["~/.rovodev"]
  },
  "configs": {
    "user": {
      "path": "~/.rovodev/mcp.json",
      "createIfMissing": true
    }
  },
  "format": "json",
  "rootKey": "mcpServers",
  "entry": {
    "stdio": {
      "command": "{command}",
      "args": "{args}",
      "env": "{env}",
      "transport": "stdio"
    }
  },
  "supports": {
    "stdio": true,
    "http": true,
    "envExpansion": false,
    "cmdShims": false
  },
  "restartRequired": true,
  "status": "stable",
  "mergeStrategy": "edit",
  "lastVerified": "2026-09-25",
  "maintainers": []
}
