{
  "$schema": "../../schemas/tool.schema.json",
  "version": 1,
  "id": "warp",
  "name": "Warp",
  "aliases": ["warp-terminal"],
  "homepage": "https://www.warp.dev",
  "docs": {
    "mcp": "https://docs.warp.dev/knowledge-and-collaboration/mcp"
  },
  "detect": {
    "commands": ["warp"],
    "paths": ["~/.warp"]
  },
  "configs": {
    "user": {
      "path": "~/.warp/.mcp.json",
      "createIfMissing": true
    },
    "project": {
      "path": "{cwd}/.warp/.mcp.json",
      "createIfMissing": true
    }
  },
  "alsoReads": [
    {
      "tool": "claude-code",
      "scope": "user",
      "when": "setting",
      "setting": "Auto-spawn servers from third-party agents",
      "compatible": true,
      "note": "starts Claude Code's servers when auto-spawn for third-party agents is on",
      "source": "https://docs.warp.dev/knowledge-and-collaboration/mcp"
    },
    {
      "tool": "codex",
      "scope": "user",
      "when": "setting",
      "setting": "Auto-spawn servers from third-party agents",
      "compatible": true,
      "note": "starts Codex's servers when auto-spawn for third-party agents is on",
      "source": "https://docs.warp.dev/knowledge-and-collaboration/mcp"
    },
    {
      "tool": "claude-code",
      "scope": "project",
      "when": "approval",
      "compatible": true,
      "note": "offers the project .mcp.json servers for approval",
      "source": "https://docs.warp.dev/knowledge-and-collaboration/mcp"
    }
  ],
  "format": "json",
  "rootKey": "mcpServers",
  "entry": {
    "stdio": {
      "command": "{command}",
      "args": "{args}",
      "env": "{env}"
    }
  },
  "supports": {
    "stdio": true,
    "http": true,
    "envExpansion": false,
    "cmdShims": false
  },
  "restartRequired": false,
  "status": "beta",
  "mergeStrategy": "edit",
  "lastVerified": "2026-09-25",
  "maintainers": []
}
