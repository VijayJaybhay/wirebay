{
  "$schema": "../../schemas/tool.schema.json",
  "version": 1,
  "id": "antigravity",
  "name": "Google Antigravity",
  "aliases": ["google-antigravity"],
  "homepage": "https://antigravity.google",
  "docs": {
    "mcp": "https://antigravity.google/docs/mcp/"
  },
  "detect": {
    "commands": ["antigravity"],
    "paths": ["~/.gemini/config", "~/.gemini/antigravity"]
  },
  "configs": {
    "user": {
      "path": "~/.gemini/config/mcp_config.json",
      "createIfMissing": true
    },
    "project": {
      "path": "{cwd}/.agents/mcp_config.json",
      "createIfMissing": true
    }
  },
  "format": "json",
  "rootKey": "mcpServers",
  "entry": {
    "stdio": {
      "command": "{command}",
      "args": "{args}",
      "env": "{env}"
    }
  },
  "supports": {
    "stdio": true,
    "http": true,
    "envExpansion": false,
    "cmdShims": false
  },
  "restartRequired": false,
  "status": "stable",
  "mergeStrategy": "edit",
  "lastVerified": "2026-09-25",
  "maintainers": []
}
