{
  "$schema": "../../schemas/tool.schema.json",
  "version": 1,
  "id": "cursor",
  "name": "Cursor",
  "aliases": [],
  "homepage": "https://cursor.com",
  "docs": { "mcp": "https://cursor.com/docs/context/mcp" },
  "detect": { "commands": ["cursor"], "paths": ["~/.cursor"] },
  "configs": {
    "user": { "path": "~/.cursor/mcp.json", "createIfMissing": true },
    "project": { "path": "{cwd}/.cursor/mcp.json", "createIfMissing": true }
  },
  "format": "json",
  "rootKey": "mcpServers",
  "mergeStrategy": "edit",
  "entry": { "stdio": { "command": "{command}", "args": "{args}", "env": "{env}" } },
  "supports": { "stdio": true, "http": true, "envExpansion": true, "cmdShims": false },
  "restartRequired": false,
  "status": "stable",
  "lastVerified": "2026-09-25",
  "maintainers": []
}
