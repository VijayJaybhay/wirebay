{
  "$schema": "../../schemas/tool.schema.json",
  "version": 1,
  "id": "qoder",
  "name": "Qoder CLI",
  "aliases": [
    "qodercli"
  ],
  "homepage": "https://qoder.com",
  "docs": {
    "mcp": "https://docs.qoder.com/cli/mcp-servers"
  },
  "detect": {
    "commands": [
      "qodercli",
      "qoder"
    ],
    "paths": [
      "~/.qoder"
    ]
  },
  "configs": {
    "user": {
      "path": "~/.qoder/settings.json",
      "createIfMissing": true
    }
  },
  "format": "jsonc",
  "rootKey": "mcpServers",
  "entry": {
    "stdio": {
      "command": "{command}",
      "args": "{args}",
      "env": "{env}"
    }
  },
  "supports": {
    "stdio": true,
    "http": true,
    "envExpansion": false,
    "cmdShims": false
  },
  "restartRequired": true,
  "status": "beta",
  "mergeStrategy": "edit",
  "lastVerified": "2026-09-25",
  "maintainers": []
}
