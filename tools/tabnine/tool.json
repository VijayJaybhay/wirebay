{
  "$schema": "../../schemas/tool.schema.json",
  "version": 1,
  "id": "tabnine",
  "name": "Tabnine Agent (IDE and CLI)",
  "aliases": [],
  "homepage": "https://www.tabnine.com",
  "docs": {
    "mcp": "https://docs.tabnine.com/main/getting-started/tabnine-agent/mcp-intro-and-setup/mcp-server-config"
  },
  "detect": {
    "paths": ["~/.tabnine"]
  },
  "configs": {
    "user": {
      "path": "~/.tabnine/agent/settings.json",
      "createIfMissing": true
    },
    "project": {
      "path": "{cwd}/.tabnine/agent/settings.json",
      "createIfMissing": true
    }
  },
  "format": "jsonc",
  "rootKey": "mcpServers",
  "entry": {
    "stdio": {
      "command": "{command}",
      "args": "{args}",
      "env": "{env}"
    }
  },
  "supports": {
    "stdio": true,
    "http": true,
    "envExpansion": false,
    "cmdShims": false
  },
  "restartRequired": true,
  "status": "beta",
  "mergeStrategy": "edit",
  "lastVerified": "2026-09-25",
  "maintainers": []
}
