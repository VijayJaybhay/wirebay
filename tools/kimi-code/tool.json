{
  "$schema": "../../schemas/tool.schema.json",
  "version": 1,
  "id": "kimi-code",
  "name": "Kimi Code CLI (Moonshot)",
  "aliases": ["kimi"],
  "homepage": "https://www.kimi.com/code",
  "docs": {
    "mcp": "https://www.kimi.com/code/docs/en/kimi-code-cli/customization/mcp.html"
  },
  "detect": {
    "commands": ["kimi"],
    "paths": ["${KIMI_CODE_HOME:-~/.kimi-code}"]
  },
  "configs": {
    "user": {
      "path": "${KIMI_CODE_HOME:-~/.kimi-code}/mcp.json",
      "createIfMissing": true
    },
    "project": {
      "path": "{cwd}/.kimi-code/mcp.json",
      "createIfMissing": true
    }
  },
  "format": "json",
  "rootKey": "mcpServers",
  "entry": {
    "stdio": {
      "command": "{command}",
      "args": "{args}",
      "env": "{env}"
    }
  },
  "supports": {
    "stdio": true,
    "http": true,
    "envExpansion": false,
    "cmdShims": false
  },
  "restartRequired": true,
  "status": "beta",
  "mergeStrategy": "edit",
  "lastVerified": "2026-09-25",
  "maintainers": []
}
