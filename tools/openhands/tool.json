{
  "$schema": "../../schemas/tool.schema.json",
  "version": 1,
  "id": "openhands",
  "name": "OpenHands CLI",
  "aliases": [
    "open-hands"
  ],
  "homepage": "https://openhands.dev",
  "docs": {
    "mcp": "https://docs.openhands.dev/openhands/usage/cli/mcp-servers"
  },
  "detect": {
    "commands": [
      "openhands"
    ],
    "paths": [
      "~/.openhands"
    ]
  },
  "configs": {
    "user": {
      "path": "~/.openhands/mcp.json",
      "createIfMissing": true
    }
  },
  "format": "json",
  "rootKey": "mcpServers",
  "entry": {
    "stdio": {
      "command": "{command}",
      "args": "{args}",
      "env": "{env}"
    }
  },
  "supports": {
    "stdio": true,
    "http": true,
    "envExpansion": false,
    "cmdShims": false
  },
  "restartRequired": true,
  "status": "stable",
  "mergeStrategy": "edit",
  "lastVerified": "2026-09-25",
  "maintainers": []
}
