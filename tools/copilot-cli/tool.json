{
  "$schema": "../../schemas/tool.schema.json",
  "version": 1,
  "id": "copilot-cli",
  "name": "GitHub Copilot CLI",
  "aliases": ["copilot", "gh-copilot"],
  "homepage": "https://github.com/features/copilot/cli",
  "docs": { "mcp": "https://docs.github.com/en/copilot/how-tos/copilot-cli/customize-copilot/add-mcp-servers", "changelog": "https://github.com/github/copilot-cli/releases" },
  "detect": { "commands": ["copilot"], "paths": ["${COPILOT_HOME:-~/.copilot}"] },
  "configs": {
    "user": { "path": "${COPILOT_HOME:-~/.copilot}/mcp-config.json", "createIfMissing": true },
    "project": { "path": "{cwd}/.github/mcp.json", "createIfMissing": true }
  },
  "format": "json",
  "rootKey": "mcpServers",
  "mergeStrategy": "edit",
  "entry": { "stdio": { "type": "local", "command": "{command}", "args": "{args}", "env": "{env}", "tools": ["*"] } },
  "supports": { "stdio": true, "http": true, "envExpansion": true, "cmdShims": false },
  "restartRequired": false,
  "status": "stable",
  "lastVerified": "2026-09-25",
  "maintainers": []
}
