{
  "$schema": "../../schemas/tool.schema.json",
  "version": 1,
  "id": "devin",
  "name": "Devin (Devin CLI and Devin Desktop / Windsurf Cascade)",
  "aliases": ["windsurf", "devin-cli", "devin-desktop", "cascade", "codeium"],
  "homepage": "https://devin.ai/desktop",
  "docs": {
    "mcp": "https://docs.devin.ai/cli/extensibility/mcp/configuration",
    "changelog": "https://docs.devin.ai/desktop/devin-desktop-faq"
  },
  "detect": {
    "commands": ["devin", "devin-desktop", "windsurf"],
    "paths": [
      "~/.codeium",
      {
        "win32": "{appdata}/devin",
        "darwin": "${XDG_CONFIG_HOME:-~/.config}/devin",
        "linux": "${XDG_CONFIG_HOME:-~/.config}/devin"
      }
    ]
  },
  "configs": {
    "user": {
      "path": {
        "win32": "{appdata}/devin/mcp_config.json",
        "darwin": "${XDG_CONFIG_HOME:-~/.config}/devin/mcp_config.json",
        "linux": "${XDG_CONFIG_HOME:-~/.config}/devin/mcp_config.json"
      },
      "createIfMissing": true
    },
    "project": {
      "path": "{cwd}/.devin/mcp_config.json",
      "createIfMissing": true
    }
  },
  "alsoReads": [
    {
      "tool": "claude-code",
      "scope": "project",
      "when": "always",
      "compatible": true,
      "note": "imports Claude Code's .mcp.json by default (read_config_from)",
      "source": "https://docs.devin.ai/cli/reference/configuration/read-config-from"
    },
    {
      "tool": "claude-code",
      "scope": "user",
      "when": "always",
      "compatible": true,
      "note": "imports Claude Code's ~/.claude.json by default (read_config_from)",
      "source": "https://docs.devin.ai/cli/reference/configuration/read-config-from"
    },
    {
      "tool": "cursor",
      "scope": "project",
      "when": "always",
      "compatible": true,
      "note": "imports Cursor's .cursor/mcp.json by default (read_config_from)",
      "source": "https://docs.devin.ai/cli/reference/configuration/read-config-from"
    }
  ],
  "format": "json",
  "rootKey": "mcpServers",
  "mergeStrategy": "edit",
  "entry": {
    "stdio": {
      "command": "{command}",
      "args": "{args}",
      "env": "{env}"
    }
  },
  "supports": {
    "stdio": true,
    "http": true,
    "envExpansion": true,
    "cmdShims": false
  },
  "restartRequired": true,
  "status": "beta",
  "lastVerified": "2026-09-25",
  "maintainers": []
}
