{
  "$schema": "../../schemas/tool.schema.json",
  "version": 1,
  "id": "factory-droid",
  "name": "Factory Droid",
  "aliases": ["droid", "factory"],
  "homepage": "https://factory.ai",
  "docs": {
    "mcp": "https://docs.factory.ai/cli/configuration/mcp"
  },
  "detect": {
    "commands": ["droid"],
    "paths": ["~/.factory"]
  },
  "configs": {
    "user": {
      "path": "~/.factory/mcp.json",
      "createIfMissing": true
    },
    "project": {
      "path": "{cwd}/.factory/mcp.json",
      "createIfMissing": true
    }
  },
  "format": "json",
  "rootKey": "mcpServers",
  "entry": {
    "stdio": {
      "type": "stdio",
      "command": "{command}",
      "args": "{args}",
      "env": "{env}"
    }
  },
  "supports": {
    "stdio": true,
    "http": true,
    "envExpansion": true,
    "cmdShims": false
  },
  "restartRequired": false,
  "status": "stable",
  "mergeStrategy": "edit",
  "lastVerified": "2026-09-25",
  "maintainers": []
}
