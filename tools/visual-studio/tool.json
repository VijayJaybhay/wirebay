{
  "$schema": "../../schemas/tool.schema.json",
  "version": 1,
  "id": "visual-studio",
  "name": "Visual Studio 2022/2026 (Windows)",
  "aliases": ["vs", "visualstudio"],
  "homepage": "https://visualstudio.microsoft.com",
  "docs": {
    "mcp": "https://learn.microsoft.com/en-us/visualstudio/ide/mcp-servers"
  },
  "detect": {
    "paths": [
      {
        "win32": "${LOCALAPPDATA:-~/AppData/Local}/Microsoft/VisualStudio"
      }
    ],
    "configFile": false
  },
  "configs": {
    "user": {
      "path": {
        "win32": "~/.mcp.json"
      },
      "createIfMissing": true
    },
    "project": {
      "path": "{cwd}/.vs/mcp.json",
      "createIfMissing": true
    }
  },
  "alsoReads": [
    {
      "tool": "claude-code",
      "scope": "project",
      "when": "always",
      "compatible": true,
      "note": "reads <solution>\\.mcp.json",
      "source": "https://learn.microsoft.com/en-us/visualstudio/ide/mcp-servers"
    },
    {
      "tool": "vscode",
      "scope": "project",
      "when": "always",
      "compatible": true,
      "note": "reads <solution>\\.vscode\\mcp.json",
      "source": "https://learn.microsoft.com/en-us/visualstudio/ide/mcp-servers"
    },
    {
      "tool": "cursor",
      "scope": "project",
      "when": "always",
      "compatible": true,
      "note": "reads <solution>\\.cursor\\mcp.json",
      "source": "https://learn.microsoft.com/en-us/visualstudio/ide/mcp-servers"
    }
  ],
  "format": "json",
  "rootKey": "servers",
  "entry": {
    "stdio": {
      "type": "stdio",
      "command": "{command}",
      "args": "{args}",
      "env": "{env}"
    }
  },
  "supports": {
    "stdio": true,
    "http": true,
    "envExpansion": false,
    "cmdShims": false
  },
  "restartRequired": false,
  "status": "beta",
  "mergeStrategy": "edit",
  "lastVerified": "2026-09-25",
  "maintainers": []
}
