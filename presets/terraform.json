{
  "$schema": "../schemas/server.schema.json",
  "version": 1,
  "name": "terraform",
  "description": "Terraform: Registry lookups and HCP Terraform workspaces (HashiCorp); runs disabled by default",
  "category": "cloud",
  "launch": {
    "type": "stdio",
    "command": "docker",
    "args": [
      "run",
      "-i",
      "--rm",
      "-e",
      "TFE_TOKEN",
      "-e",
      "TFE_ADDRESS",
      "-e",
      "ENABLE_TF_OPERATIONS",
      "hashicorp/terraform-mcp-server:1.3.0"
    ]
  },
  "secrets": [
    {
      "key": "TFE_TOKEN",
      "description": "HCP Terraform / Enterprise API token (optional; registry tools work without)"
    },
    {
      "key": "TFE_ADDRESS",
      "description": "Terraform Enterprise URL (empty = HCP Terraform)"
    },
    {
      "key": "ENABLE_TF_OPERATIONS",
      "description": "true to allow runs/applies (default false)"
    }
  ],
  "env": {
    "ENABLE_TF_OPERATIONS": "false"
  },
  "prereqs": ["docker"],
  "docs": "https://github.com/hashicorp/terraform-mcp-server",
  "notes": [
    "Runs Docker. Registry tools work without a token; set TFE_TOKEN for HCP Terraform. Applies/destroys stay off unless ENABLE_TF_OPERATIONS=true."
  ],
  "guide": "docs/servers/catalog.md#terraform",
  "lastVerified": "2026-09-25",
  "status": "stable"
}
