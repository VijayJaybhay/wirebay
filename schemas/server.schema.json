{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/VijayJaybhay/wirebay/main/schemas/server.schema.json",
  "title": "wirebay MCP server definition",
  "type": "object",
  "required": [
    "name",
    "launch"
  ],
  "additionalProperties": false,
  "definitions": {
    "arg": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "optional"
          ],
          "additionalProperties": false,
          "properties": {
            "optional": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "description": "Dropped entirely when any variable inside it is empty"
        }
      ]
    },
    "launch": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "command"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "stdio"
            },
            "command": {
              "type": "string",
              "minLength": 1,
              "description": "Executable, e.g. npx, uvx, docker, node"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/arg"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "remote"
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Non-secret headers only"
            },
            "auth": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "enum": [
                        "none",
                        "oauth"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "secret"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "bearer"
                    },
                    "secret": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "header",
                    "secret"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "header"
                    },
                    "header": {
                      "type": "string"
                    },
                    "secret": {
                      "type": "string"
                    },
                    "prefix": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Lowercase letters, digits and dashes"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "enum": [
        "code-hosting",
        "dev-tools",
        "browser",
        "databases",
        "cloud",
        "observability",
        "productivity",
        "design",
        "search",
        "payments",
        "ai",
        "utilities"
      ],
      "description": "Groups presets in `wirebay presets` and the README"
    },
    "launch": {
      "$ref": "#/definitions/launch"
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/launch"
      }
    },
    "variant": {
      "type": "string"
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "help": {
            "type": "string"
          }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "prereqs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "docs": {
      "type": "string"
    },
    "guide": {
      "type": "string"
    },
    "lastVerified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "enum": [
        "stable",
        "beta",
        "deprecated"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Setup tips and risk notes shown in the server catalog"
    }
  }
}
