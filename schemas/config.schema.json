{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/pragnalabs-ai/wirebay/main/schemas/config.schema.json",
  "title": "wirebay user config (~/.wirebay/config.json)",
  "type": "object",
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer" },
    "defaultTools": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Tools a new server is enabled for when none are named"
    },
    "defaultScope": { "enum": ["user", "project"] },
    "renderMode": { "enum": ["auto", "absolute", "portable"] },
    "paths": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Absolute paths to executables such as npx, uvx, docker"
    },
    "servers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["tools"],
        "properties": { "tools": { "type": "array", "items": { "type": "string" } } }
      }
    }
  }
}
